rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidDivision(val, allowEmpty) {
      return val is string && val.size() <= 10 && (
        val in ['Comp', 'IT', 'Entc', 'Other'] || (allowEmpty && val == '')
      );
    }

    function isValidBatch(val, allowEmpty) {
      return val is string && val.size() <= 4 && (
        val in ['2024', '2025', '2026', '2027'] || (allowEmpty && val == '')
      );
    }

    function isValidYear(val, allowEmpty) {
      return val is string && val.size() <= 10 && (
        val in ['1st Year', '2nd Year', '3rd Year', '4th Year'] || (allowEmpty && val == '')
      );
    }

    function isValidDob(val, allowEmpty) {
      return val is string && val.size() <= 10 && (
        val.matches('^\\d{4}-\\d{2}-\\d{2}$') || (allowEmpty && val == '')
      );
    }

    function isValidPhone(val, allowEmpty) {
      return val is string && val.size() <= 20 && (
        val.matches('^\\+?[0-9 ()-]{7,20}$') || (allowEmpty && val == '')
      );
    }

    function isValidAvatarUrl(val) {
      return val is string && val.size() <= 100000 && (
        val == '' ||
        val.matches('^https://.*') ||
        val.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$')
      );
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'id', 'username', 'full_name', 'department', 'division', 'batch', 'year',
          'date_of_birth', 'college', 'phone', 'avatar_url', 'created_at', 'updated_at'
        ])
        && data.keys().hasOnly([
          'id', 'username', 'full_name', 'department', 'division', 'batch', 'year',
          'date_of_birth', 'college', 'phone', 'avatar_url', 'created_at', 'updated_at'
        ])
        && isValidId(data.id)
        && data.id == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 100
        && data.full_name is string && data.full_name.size() <= 100
        && data.department is string && data.department.size() <= 100
        && isValidDivision(data.division, true)
        && isValidBatch(data.batch, true)
        && isValidYear(data.year, true)
        && isValidDob(data.date_of_birth, true)
        && data.college is string && data.college.size() <= 150
        && isValidPhone(data.phone, true)
        && isValidAvatarUrl(data.avatar_url)
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function isValidEventId(id) {
      return id is string && id.size() <= 64 && id in [
        'freshers-garba-session',
        'open-mic-night',
        'creative-challenge',
        'football-tournament',
        'tech-talk-series',
        'dance-workshop'
      ];
    }

    function isValidStudentDetails(details) {
      return details is map
        && details.keys().hasAll([
          'full_name', 'division', 'batch', 'year', 'date_of_birth', 'college', 'phone', 'terms'
        ])
        && details.keys().hasOnly([
          'full_name', 'division', 'batch', 'year', 'date_of_birth', 'college', 'phone', 'terms'
        ])
        && details.full_name is string && details.full_name.size() >= 1 && details.full_name.size() <= 100
        && isValidDivision(details.division, false)
        && isValidBatch(details.batch, false)
        && isValidYear(details.year, false)
        && isValidDob(details.date_of_birth, false)
        && details.college is string && details.college.size() >= 1 && details.college.size() <= 150
        && isValidPhone(details.phone, false)
        && details.terms == true;
    }

    function isValidEventRegistration(data) {
      return data.keys().hasAll(['id', 'user_id', 'event_id', 'student_details', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'event_id', 'student_details', 'created_at'])
        && isValidId(data.id)
        && isValidId(data.user_id)
        && data.user_id == request.auth.uid
        && isValidEventId(data.event_id)
        && isValidStudentDetails(data.student_details)
        && data.created_at is timestamp;
    }

    function isValidClubId(id) {
      return id is string && id.size() <= 32 && id in [
        'dance',
        'web-design',
        'game-design',
        'robotics',
        'arts-design',
        'sports'
      ];
    }

    function isValidClubName(clubId, name) {
      return name is string && name.size() >= 1 && name.size() <= 100 && (
        (clubId == 'dance' && name == 'Dance Club') ||
        (clubId == 'web-design' && name == 'Web Designing Club') ||
        (clubId == 'game-design' && name == 'Game Designing Club') ||
        (clubId == 'robotics' && name == 'Robotics Club') ||
        (clubId == 'arts-design' && name == 'Arts & Design Club') ||
        (clubId == 'sports' && name == 'Sports Club')
      );
    }

    function isValidClub(data) {
      return data.keys().hasAll(['id', 'name', 'member_count'])
        && data.keys().hasOnly(['id', 'name', 'member_count'])
        && isValidClubId(data.id)
        && isValidClubName(data.id, data.name)
        && data.member_count is int
        && data.member_count >= 0;
    }

    function isValidClubMembership(data) {
      return data.keys().hasAll(['id', 'user_id', 'club_id', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'club_id', 'created_at'])
        && isValidId(data.id)
        && isValidId(data.user_id)
        && data.user_id == request.auth.uid
        && isValidClubId(data.club_id)
        && data.created_at is timestamp;
    }

    function isValidClubSuggestion(data) {
      return data.keys().hasAll(['id', 'user_id', 'club_name', 'category', 'reason', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'club_name', 'category', 'reason', 'created_at'])
        && isValidId(data.id)
        && isValidId(data.user_id)
        && data.user_id == request.auth.uid
        && data.club_name is string && data.club_name.size() >= 1 && data.club_name.size() <= 100
        && data.category is string && data.category.size() <= 20
        && data.category in ['Technical', 'Cultural', 'Sports', 'Workshop', 'Social', 'Other']
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 1000
        && data.created_at is timestamp;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidProfile(incoming())
        && incoming().created_at == request.time
        && incoming().updated_at == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidProfile(incoming())
        && incoming().id == existing().id
        && incoming().created_at == existing().created_at
        && incoming().updated_at == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'full_name', 'department', 'division', 'batch', 'year',
          'date_of_birth', 'college', 'phone', 'avatar_url', 'updated_at'
        ]);
      allow delete: if false;
    }

    match /event_registrations/{registrationId} {
      allow get: if isSignedIn() && isValidId(registrationId) && (
        (resource == null && registrationId.matches('^' + request.auth.uid + '_.*')) ||
        (resource != null && existing().user_id == request.auth.uid)
      );
      allow list: if isSignedIn() && existing().user_id == request.auth.uid;
      allow create: if isVerified()
        && isValidId(registrationId)
        && isValidEventRegistration(incoming())
        && incoming().id == registrationId
        && registrationId == request.auth.uid + '_' + incoming().event_id
        && incoming().created_at == request.time
        && !exists(/databases/$(database)/documents/event_registrations/$(registrationId));
      allow update, delete: if false;
    }

    match /clubs/{clubId} {
      allow get: if isValidId(clubId) && isValidClubId(clubId);
      allow list: if true;
      allow create: if isVerified()
        && isValidId(clubId)
        && isValidClub(incoming())
        && incoming().id == clubId
        && incoming().member_count == 0;
      allow update: if isVerified()
        && isValidId(clubId)
        && isValidClub(incoming())
        && incoming().id == existing().id
        && incoming().name == existing().name
        && incoming().diff(existing()).affectedKeys().hasOnly(['member_count'])
        && incoming().member_count == existing().member_count + 1
        && !exists(/databases/$(database)/documents/club_memberships/$(request.auth.uid + '_' + clubId))
        && existsAfter(/databases/$(database)/documents/club_memberships/$(request.auth.uid + '_' + clubId));
      allow delete: if false;
    }

    match /club_memberships/{membershipId} {
      allow get: if isSignedIn() && isValidId(membershipId) && (
        (resource == null && membershipId.matches('^' + request.auth.uid + '_.*')) ||
        (resource != null && existing().user_id == request.auth.uid)
      );
      allow list: if isSignedIn() && existing().user_id == request.auth.uid;
      allow create: if isVerified()
        && isValidId(membershipId)
        && isValidClubMembership(incoming())
        && incoming().id == membershipId
        && membershipId == request.auth.uid + '_' + incoming().club_id
        && incoming().created_at == request.time
        && !exists(/databases/$(database)/documents/club_memberships/$(membershipId))
        && exists(/databases/$(database)/documents/clubs/$(incoming().club_id))
        && getAfter(/databases/$(database)/documents/clubs/$(incoming().club_id)).data.member_count == get(/databases/$(database)/documents/clubs/$(incoming().club_id)).data.member_count + 1;
      allow update, delete: if false;
    }

    match /club_suggestions/{suggestionId} {
      allow get: if isSignedIn() && isValidId(suggestionId) && (resource == null || existing().user_id == request.auth.uid);
      allow list: if isSignedIn() && existing().user_id == request.auth.uid;
      allow create: if isVerified()
        && isValidId(suggestionId)
        && isValidClubSuggestion(incoming())
        && incoming().id == suggestionId
        && incoming().created_at == request.time;
      allow update, delete: if false;
    }
  }
}
