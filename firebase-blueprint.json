{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Allowlisted portal administrator or event coordinator.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin"]
        },
        "added_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "email", "name", "role", "added_by", "created_at"]
    },
    "Event": {
      "title": "Event",
      "description": "Shared campus event managed by admins and displayed across Student and Admin portals.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tag": {
          "type": "string",
          "enum": ["Cultural", "Technical", "Creative", "Design", "Sports", "Social", "Workshop", "Other"]
        },
        "status": {
          "type": "string",
          "enum": ["upcoming", "ongoing", "past"]
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tags": {
          "type": "string",
          "maxLength": 120
        },
        "image": {
          "type": "string",
          "maxLength": 100000
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "registration_open": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "tag",
        "status",
        "date",
        "time",
        "place",
        "tags",
        "image",
        "description",
        "registration_open",
        "created_at",
        "updated_at"
      ]
    },
    "StudentDetails": {
      "title": "StudentDetails",
      "description": "Validated student details attached to an event registration.",
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "division": {
          "type": "string",
          "enum": ["Comp", "IT", "Entc", "Other"]
        },
        "batch": {
          "type": "string",
          "enum": ["2024", "2025", "2026", "2027"]
        },
        "year": {
          "type": "string",
          "enum": ["1st Year", "2nd Year", "3rd Year", "4th Year"]
        },
        "date_of_birth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "college": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^\\+?[0-9 ()-]{7,20}$"
        },
        "terms": {
          "type": "boolean"
        }
      },
      "required": ["full_name", "division", "batch", "year", "date_of_birth", "college", "phone", "terms"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Private student profile record owned by a single authenticated user and readable by admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "full_name": {
          "type": "string",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "maxLength": 100
        },
        "division": {
          "type": "string",
          "enum": ["", "Comp", "IT", "Entc", "Other"]
        },
        "batch": {
          "type": "string",
          "enum": ["", "2024", "2025", "2026", "2027"]
        },
        "year": {
          "type": "string",
          "enum": ["", "1st Year", "2nd Year", "3rd Year", "4th Year"]
        },
        "date_of_birth": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "college": {
          "type": "string",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\+?[0-9 ()-]{7,20})?$"
        },
        "avatar_url": {
          "type": "string",
          "maxLength": 100000
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "username", "full_name", "department", "division", "batch", "year", "date_of_birth", "college", "phone", "avatar_url", "created_at", "updated_at"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Student registration for a specific campus event.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "student_details": {
          "type": "object",
          "$ref": "#/entities/StudentDetails"
        },
        "attendance_status": {
          "type": "string",
          "enum": ["registered", "attended", "absent", "cancelled"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "user_id", "event_id", "student_details", "created_at"]
    },
    "Club": {
      "title": "Club",
      "description": "Public campus club summary with transactionally updated member count.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["dance", "web-design", "game-design", "robotics", "arts-design", "sports"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "member_count": {
          "type": "integer"
        }
      },
      "required": ["id", "name", "member_count"]
    },
    "ClubMembership": {
      "title": "ClubMembership",
      "description": "Unique student membership record for a campus club.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "club_id": {
          "type": "string",
          "enum": ["dance", "web-design", "game-design", "robotics", "arts-design", "sports"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "user_id", "club_id", "created_at"]
    },
    "ClubSuggestion": {
      "title": "ClubSuggestion",
      "description": "Student-submitted suggestion for a new campus club, reviewable by admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "club_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["Technical", "Cultural", "Sports", "Workshop", "Social", "Other"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "declined"]
        },
        "admin_note": {
          "type": "string",
          "maxLength": 500
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "user_id", "club_name", "category", "reason", "created_at"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Allowlisted admin coordinator records managed by verified admins."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Public campus events catalog managed by admins and displayed to students."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Owner-only student profile documents keyed by Firebase Auth UID (readable by admins)."
    },
    "/event_registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/EventRegistration" },
      "description": "Owner-scoped event registration documents keyed by {userId}_{eventId} (readable/manageable by admins)."
    },
    "/clubs/{clubId}": {
      "schema": { "$ref": "#/entities/Club" },
      "description": "Public campus club directory and live member counts."
    },
    "/club_memberships/{membershipId}": {
      "schema": { "$ref": "#/entities/ClubMembership" },
      "description": "Owner-scoped unique club memberships keyed by {userId}_{clubId} (readable by admins)."
    },
    "/club_suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/ClubSuggestion" },
      "description": "Owner-scoped new club suggestions submitted by signed-in students and reviewed by admins."
    }
  }
}
